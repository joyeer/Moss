import moss.binary
import moss.jvm
import moss.model
import moss.output

public func selectMethod(file: borrowing ClassFile, name: borrowing String,
    type: borrowing String): Result<Int, Diagnostic> {
    let wanted = utf8Units(text: name)?
    let descriptor = utf8Units(text: type)?
    var found = -1
    var index = 0
    while index < file.methods.count {
        if compareUnits(first: wanted, second: file.pool[file.methods[index].nameIndex].text) == 0 &&
            (type.count == 0 || compareUnits(first: descriptor,
                second: file.pool[file.methods[index].descriptorIndex].text) == 0) {
            if found >= 0 {
                return .Err(Diagnostic(code: "query.ambiguous-method", offset: -1,
                    context: "method selector", message: "multiple overloads match; supply --descriptor"))
            }
            found = index
        }
        index = index + 1
    }
    if found < 0 {
        return .Err(Diagnostic(code: "query.method-not-found", offset: -1,
            context: "method selector", message: "no method matches the exact name and descriptor"))
    }
    return .Ok(found)
}

public func instructionPage(instructions: borrowing [Instruction], codeLength: Int,
    offset: Int, limit: Int): Result<Page, Diagnostic> {
    if limit < 1 || limit > 10000 || offset < 0 || offset > codeLength {
        return .Err(Diagnostic(code: "query.invalid-offset", offset: -1,
            context: "page", message: "offset or page limit lies outside the method"))
    }
    var first = instructions.count
    if offset != codeLength {
        first = match instructionIndex(instructions: instructions, offset: offset) {
            .Some(index) => index,
            .None => {
                return .Err(Diagnostic(code: "query.invalid-offset", offset: -1,
                    context: "page", message: "offset must be an instruction start, not an operand byte"))
            },
        }
    }
    var count = instructions.count - first
    if count > limit { count = limit }
    let end = first + count
    var next: Int? = .None
    if end < instructions.count { next = .Some(instructions[end].methodOffset) }
    return .Ok(Page(first: first, end: end, nextOffset: next))
}

public func analyzeBytes(options: borrowing Options, input: borrowing String): Result<String, Diagnostic> {
    let file = parseClass(input: input, allowPreview: options.allowPreview)?
    var method = -1
    var instructions: [Instruction] = []
    var page = Page(first: 0, end: file.methods.count, nextOffset: .None)
    if options.command == "disasm" {
        if options.methodIndex >= 0 {
            if options.methodIndex >= file.methods.count {
                return .Err(Diagnostic(code: "query.method-not-found", offset: -1,
                    context: "method selector", message: "method index exceeds the inventory"))
            }
            method = options.methodIndex
        } else {
            method = selectMethod(file: file, name: options.method, type: options.descriptor)?
        }
        instructions = decodeMethod(input: input, file: file, methodIndex: method)?
        let length = match file.methods[method].code {
            .Some(code) => code.bytes.length,
            .None => 0,
        }
        page = instructionPage(instructions: instructions, codeLength: length,
            offset: options.offset, limit: options.limit)?
    } else if options.command == "methods" {
        if options.offset > file.methods.count {
            return .Err(Diagnostic(code: "query.invalid-offset", offset: -1,
                context: "methods", message: "offset exceeds the method inventory"))
        }
        var count = file.methods.count - options.offset
        if count > options.limit { count = options.limit }
        let end = options.offset + count
        var next: Int? = .None
        if end < file.methods.count { next = .Some(end) }
        page = Page(first: options.offset, end: end, nextOffset: next)
    }
    let contents = render(input: input, file: file, path: options.path,
        command: options.command, format: options.format, methodIndex: method,
        instructions: instructions, page: page)?
    // Both print and file output add exactly one final newline.
    if contents.count >= maximumOutputBytes() {
        return .Err(Diagnostic(code: "output.budget-exceeded", offset: -1,
            context: "output", message: "final newline would exceed the inclusive 8 MiB ceiling"))
    }
    return .Ok(contents)
}

public func analyze(options: borrowing Options): Result<String, Diagnostic> {
    let input = match readInput(path: options.path) {
        .Ok(bytes) => bytes,
        .Err(error) => {
            var message = "cannot acquire input '" + options.path + "'"
            match inputHostCode(error: error) {
                .Some(code) => { message = message + " (native code " + decimal(value: code) + ")" },
                .None => {},
            }
            return .Err(Diagnostic(code: inputErrorCode(error: error),
                offset: -1, context: "input", message: message))
        },
    }
    return analyzeBytes(options: options, input: input)
}
