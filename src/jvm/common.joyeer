import moss.binary
import moss.model

struct ParseBudget {
    var records: Int
    var textBytes: Int
}

func diagnostic(code: String, offset: Int, context: String, message: String): moss.model.Diagnostic {
    return moss.model.Diagnostic(code: code, offset: offset, context: context, message: message)
}

func binaryDiagnostic(error: moss.binary.BinaryError): moss.model.Diagnostic {
    return diagnostic(code: moss.binary.binaryErrorCode(error: error), offset: error.offset,
        context: error.context, message: "requested " + moss.model.decimal(value: error.requested) +
        " bytes; available " + moss.model.decimal(value: error.available))
}

func u(input: String, cursor: inout moss.binary.Cursor, width: Int,
    context: String): Result<Int, moss.model.Diagnostic> {
    return match moss.binary.readUnsigned(input: input, cursor: &cursor, width: width, context: context) {
        .Ok(value) => .Ok(value),
        .Err(error) => .Err(binaryDiagnostic(error: error)),
    }
}

func s(input: String, cursor: inout moss.binary.Cursor, width: Int,
    context: String): Result<Int, moss.model.Diagnostic> {
    return match moss.binary.readSigned(input: input, cursor: &cursor, width: width, context: context) {
        .Ok(value) => .Ok(value),
        .Err(error) => .Err(binaryDiagnostic(error: error)),
    }
}

func take(input: String, cursor: inout moss.binary.Cursor, length: Int,
    context: String): Result<moss.model.ByteRange, moss.model.Diagnostic> {
    return match moss.binary.takeSpan(input: input, cursor: &cursor, length: length, context: context) {
        .Ok(region) => .Ok(moss.model.ByteRange(offset: region.offset, length: region.length)),
        .Err(error) => .Err(binaryDiagnostic(error: error)),
    }
}

func bounded(input: String, region: moss.model.ByteRange,
    context: String): Result<moss.binary.Cursor, moss.model.Diagnostic> {
    return match moss.binary.boundedCursor(input: input,
        region: moss.binary.Span(offset: region.offset, length: region.length), context: context) {
        .Ok(cursor) => .Ok(cursor),
        .Err(error) => .Err(binaryDiagnostic(error: error)),
    }
}

func finished(cursor: moss.binary.Cursor, context: String): Result<Void, moss.model.Diagnostic> {
    if cursor.position != cursor.end {
        return .Err(diagnostic(code: "jvm.trailing-bytes", offset: cursor.position,
            context: context, message: "unconsumed bytes in declared region"))
    }
    return .Ok(())
}

func charge(budget: inout ParseBudget, count: Int, offset: Int): Result<Void, moss.model.Diagnostic> {
    if count > 262144 - budget.records {
        return .Err(diagnostic(code: "jvm.resource-limit", offset: offset,
            context: "metadata", message: "metadata exceeds 262144 records"))
    }
    &budget.records = budget.records + count
    return .Ok(())
}

func count16(input: String, cursor: inout moss.binary.Cursor, minimumBytes: Int,
    budget: inout ParseBudget, context: String): Result<Int, moss.model.Diagnostic> {
    let count = u(input: input, cursor: &cursor, width: 2, context: context)?
    if count > (cursor.end - cursor.position) / minimumBytes {
        return .Err(diagnostic(code: "binary.truncated", offset: cursor.position,
            context: context, message: "count exceeds remaining byte budget"))
    }
    charge(budget: &budget, count: count, offset: cursor.position - 2)?
    return .Ok(count)
}

func requireTag(pool: [moss.model.Constant], index: Int, tag: Int,
    offset: Int, context: String): Result<Void, moss.model.Diagnostic> {
    if index <= 0 || index >= pool.count || pool[index].tag == 0 {
        return .Err(diagnostic(code: "jvm.invalid-constant-index", offset: offset,
            context: context, message: "constant pool index is absent or unusable"))
    }
    if tag != 0 && pool[index].tag != tag {
        return .Err(diagnostic(code: "jvm.invalid-constant-tag", offset: offset,
            context: context, message: "unexpected constant pool tag"))
    }
    return .Ok(())
}

func utf8(pool: [moss.model.Constant], index: Int,
    offset: Int, context: String): Result<[Int], moss.model.Diagnostic> {
    requireTag(pool: pool, index: index, tag: 1, offset: offset, context: context)?
    return .Ok(pool[index].text)
}

func named(pool: [moss.model.Constant], index: Int, name: String): Bool {
    return index > 0 && index < pool.count && pool[index].tag == 1 &&
        moss.model.unitsEqualAscii(units: pool[index].text, text: name)
}
